<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>PR Monitor: third-party licenses</title>
<style>
body{font:14px/1.5 system-ui,sans-serif;max-width:960px;margin:2rem auto;padding:0 1rem;color:#1f2328}
pre{white-space:pre-wrap;background:#f6f8fa;padding:1rem;border-radius:6px;font-size:12px}
.license{list-style:none;border-top:1px solid #d0d7de;padding-top:1rem}
</style>
</head>
<body>
<h1>Third-party licenses</h1>
<p>PR Monitor is licensed under MIT OR Apache-2.0 and includes the third-party software listed below.
Embedded fonts (SIL OFL 1.1) are listed in the <code>licenses/</code> folder of this archive.</p>
<h2>Overview</h2>
<ul>{{#each overview}}<li><a href="#{{id}}">{{name}}</a> ({{count}})</li>{{/each}}</ul>
<h2>License texts</h2>
<ul>
{{#each licenses}}
<li class="license">
<h3 id="{{id}}">{{name}}</h3>
<p>Used by:</p>
<ul>{{#each used_by}}<li><a href="{{#if crate.repository}}{{crate.repository}}{{else}}https://crates.io/crates/{{crate.name}}{{/if}}">{{crate.name}} {{crate.version}}</a></li>{{/each}}</ul>
<pre>{{text}}</pre>
</li>
{{/each}}
</ul>
</body>
</html>
