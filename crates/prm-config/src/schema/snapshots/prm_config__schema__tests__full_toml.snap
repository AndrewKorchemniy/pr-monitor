---
source: crates/prm-config/src/schema/tests.rs
expression: "toml::to_string_pretty(&config).unwrap()"
---
schema_version = 1

[refresh]
interval_minutes = 5
jitter_percent = 10
startup_delay_secs = 0

[notifications]
enabled = true
when_focused = "suppress"
max_per_refresh = 3
sound = true
include_drafts = false

[notifications.events]
new_pr = true
ready_for_review = true
needs_re_review = true
reviewed = true
changes_requested = true
new_vote = false
new_comments = true
comments_resolved = true
reactivated = true
closed = false
new_push = false
auth_problem = true

[ui]
theme = "system"
theme_dark = "graphite"
theme_light = "vellum"
font_scale = 1.0
animations = "auto"
renderer = "auto"
low_power = "auto"
start_minimized = false
close_to_tray = true
minimize_to_tray = true
launch_at_login = false
show_org_column = "auto"
relative_times = true

[network]
proxy = "system"
connect_timeout_secs = 10
request_timeout_secs = 30
max_concurrency = 6

[diagnostics]
log_level = "info"

[[orgs]]
id = "contoso"
url = "https://dev.azure.com/contoso"
label = "Contoso"
enabled = true
auth = "auto"
tenant = ""
include_me = true
drafts = "show"
muted = false
org_wide_query = false
pat_expires_on = ""

[orgs.review]
empty_reviewer_list = "any_non_author_vote"

[orgs.entra]
client_id = ""
tenant = ""

[orgs.scope]
all_projects = false

