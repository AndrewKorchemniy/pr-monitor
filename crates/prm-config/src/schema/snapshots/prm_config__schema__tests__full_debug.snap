                    },
                    Person {
                        id: Vsid(98d08d98-4b5c-4c0b-8d2e-1f0c5b6a7e91),
                        name: "[Payments]\\Payments Team",
                        unique_name: None,
                        group: true,
                        descriptor: None,
                    },
                ],
                ignored_comment_authors: [
                    Person {
                        id: Vsid(41113706-0000-4000-8000-000000000001),
                        name: "GitHub Copilot",
                        unique_name: None,
                        group: false,
                        descriptor: None,
                    },
                ],
            },
        },
        OrgProfile {
            id: Some(
                OrgId(
                    "fabrikam",
                ),
            ),
            url: "https://dev.azure.com/fabrikam",
            label: "Fabrikam (contractor)",
            enabled: true,
            auth: Pat,
            tenant: "",
            include_me: false,
